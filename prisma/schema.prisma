generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
}

enum Status {
    PENDING
    REAL
    COMPLETED
}

model Report {
    id                 String   @id @default(uuid())
    title              String
    description        String
    categories         Json
    latitude           Float
    longitude          Float
    imageUrl           String?
    resolutionImageUrl String?
    userEmail          String?
    status             Status   @default(PENDING)
    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt
    upvotes            Upvote[]

    @@index([status])
    @@index([createdAt])
}

model Upvote {
    id        String   @id @default(uuid())
    reportId  String
    userIp    String
    createdAt DateTime @default(now())
    report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

    @@unique([reportId, userIp])
    @@index([reportId])
}
